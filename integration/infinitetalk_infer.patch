+OPTIMIZED = os.environ.get("INFINITETALK_OPTIMIZED", "0") == "1"
+FRAME_WINDOW_SIZE = 49 if OPTIMIZED else 81
+WAN_MODEL = (
+    "Wan2_1-I2V-14B-480P_fp8_e4m3fn.safetensors" if OPTIMIZED
+    else "wan2.1-i2v-14b-480p-Q8_0.gguf"
